{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "app.ts",
    "index.ts",
    "config/**/*",
    "controllers/**/*",
    "middlewares/**/*",
    "routes/**/*",
    "types/**/*"
  ],
  "exclude": ["node_modules", "dist", "src", "public"]
}
